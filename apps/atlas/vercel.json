{
  "version": 2,
  "builds": [
    { "src": "api/*.py", "use": "@vercel/python" },
    { "src": "api/datasets/[id].py", "use": "@vercel/python" },
    { "src": "api/datasets/[id]/*.py", "use": "@vercel/python" },
    { "src": "package.json", "use": "@vercel/static-build" }
  ],
  "routes": [
    { "src": "/api/thermal", "dest": "/api/thermal.py" },
    { "src": "/api/preview-layer", "dest": "/api/preview-layer.py" },
    { "src": "/api/run-qa", "dest": "/api/run-qa.py" },
    { "src": "/api/health", "dest": "/api/health.py" },
    { "src": "/api/datasets", "dest": "/api/datasets.py" },
    { "src": "/api/datasets/([^/]+)", "dest": "/api/datasets/[id].py" },
    { "src": "/api/datasets/([^/]+)/geojson", "dest": "/api/datasets/[id]/geojson.py" },
    { "src": "/api/datasets/([^/]+)/cleaned-geojson", "dest": "/api/datasets/[id]/cleaned-geojson.py" },
    { "src": "/api/datasets/([^/]+)/report", "dest": "/api/datasets/[id]/report.py" },
    { "src": "/api/datasets/([^/]+)/issues", "dest": "/api/datasets/[id]/issues.py" }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": []
}